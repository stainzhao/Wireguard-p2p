[Unit]
Description=WireGuard P2P peer synchronizer
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=__SERVICE_USER__
Group=__SERVICE_USER__
ExecStart=/usr/bin/python3 /opt/wireguard-p2p/p2p_sync.py
Restart=always
RestartSec=5
TimeoutStopSec=10
RuntimeDirectory=wireguard-p2p
RuntimeDirectoryMode=0700
UMask=0077

# Legacy compatibility path: routine event output is discarded, while actual
# sync errors are emitted on stderr and remain diagnosable in the journal.
StandardOutput=null
StandardError=journal
LogRateLimitIntervalSec=5min
LogRateLimitBurst=20

AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
