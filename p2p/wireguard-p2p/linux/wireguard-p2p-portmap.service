[Unit]
Description=WireGuard P2P automatic IPv4 port mapping
Wants=network-online.target
After=network-online.target wireguard-p2p-agent.service

[Service]
Type=simple
User=__SERVICE_USER__
Group=__SERVICE_USER__
Environment=P2P_INTERFACE=wg0
ExecStart=/usr/bin/python3 /opt/wireguard-p2p/portmap_daemon.py
Restart=always
RestartSec=5
TimeoutStopSec=10
RuntimeDirectory=wireguard-p2p
RuntimeDirectoryMode=0700
UMask=0077

# Port mapping is silent in steady state. Keep only stderr diagnostics and
# prevent a repeating router/tool failure from growing the persistent journal.
StandardOutput=null
StandardError=journal
LogRateLimitIntervalSec=5min
LogRateLimitBurst=20

AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
